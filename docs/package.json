{
  "name": "refarch-docs",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=11.6 <12"
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "lint": "prettier . --check --cache && markdownlint .",
    "fix": "prettier . --write --cache && markdownlint -f ."
  },
  "devDependencies": {
    "@muenchen/prettier-codeformat": "1.0.2",
    "markdownlint-cli": "0.49.1",
    "mermaid": "11.17.2",
    "prettier": "3.9.9",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "vite": "6.4.3",
    "vitepress": {
      "postcss": {
        "source-map-js": "1.2.2"
      }
    },
    "@muenchen/prettier-codeformat": {
      "@ianvs/prettier-plugin-sort-imports": {
        "@vue/compiler-sfc": {
          "source-map-js": "1.2.2",
          "@vue/compiler-core": {
            "source-map-js": "1.2.2"
          }
        }
      }
    },
    "mermaid": {
      "katex": "0.18.2",
      "dompurify": "3.4.16"
    },
    "markdownlint-cli": {
      "js-yaml": "5.4.2",
      "smol-toml": "1.9.0",
      "markdownlint": {
        "micromark-extension-math": {
          "katex": "0.18.2"
        }
      }
    }
  }
}
